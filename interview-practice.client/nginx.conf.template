server {
    listen ${CLIENT_PORT};
    server_name _;

    # Must match the server's MAX_UPLOAD_MB: nginx's 1m default would reject document
    # uploads before they reach Flask.
    client_max_body_size ${MAX_UPLOAD_MB}m;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxied to the `server` Compose service by name — same origin from the
    # browser's perspective, so no CORS is involved in this deployment shape at all.
    location /api/ {
        proxy_pass http://server:${SERVER_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Angular's client-side routing — fall back to index.html for any unknown path.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
