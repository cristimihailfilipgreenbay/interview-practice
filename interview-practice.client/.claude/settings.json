{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "model": "claude-sonnet-5",
    "permissions": {
        "allow": [
            "Bash(ng generate *)",
            "Bash(ng build *)",
            "Bash(ng server *)",
            "Bash(ng test *)",
            "Bash(nom run *)",
            "Read(*)",
            "Glob(*)",
            "Grep(*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./src/environments/*.local.ts)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx prettier --write \"$CLAUDE_TOOL_INPUT_FILE_PATH\""
                    }
                ]
            }
        ]
    }
}