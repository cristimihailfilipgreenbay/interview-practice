{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "model": "claude-sonnet-5",
    "permissions": {
        "allow": [
            "Bash(ruff *)",
            "Bash(mypy *)",
            "Bash(pytest *)",
            "Bash(flask db *)",
            "Bash(flask run *)",
            "Bash(uv add *)",
            "Bash(uv sync *)",
            "Bash(uv run *)",
            "Read"
        ],
        "deny": ["Read(./.env)", "Bash(git commit *)", "Bash(git push *)"]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) uv run ruff format \"$f\" ;; esac; } 2>/dev/null || true"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run ruff check . && uv run mypy app"
                    }
                ]
            }
        ]
    }
}
